# Independent external repositories are reproduced through the manifest.
/externals/*
!/externals/README.md
!/externals/manifest.json
/data/*
!/data/README.md
!/data/sample_data/
/data/sample_data/**
!/data/sample_data/**/
!/data/sample_data/**/README.md
!/data/sample_data/manifest.json
!/data/sample_data/UMR-LICENSE.txt
/outputs/*
!/outputs/README.md
__pycache__/
*.py[cod]
.venv/
.env
.env.*
!.env.example
.DS_Store
/.codex/
/.agents/
/.aws/

# Generated complete documentation compatibility entries.
/docs.html
/docs-basic.html
/docs/site/home.html

# Isolated local REA analysis tooling and Node runtime.
/.cache/rea-tooling/
