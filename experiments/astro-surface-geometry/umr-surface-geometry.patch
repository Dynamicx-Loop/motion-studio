+"""Deterministic regressions for the isolated primitive surface experiment."""
+import sys
+import unittest
+from pathlib import Path
+
+import mujoco
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
+import mujoco_geom_surface as geom
+import smpl_surface_retarget_common as common
+from primitive_surface import PrimitiveUnion
+from types import SimpleNamespace
+import retarget_smpl_to_humanoid_surface_vector as single
+import retarget_smpl_to_humanoid_surface_vector_batch as batch
+
+
+class SurfaceGeometryTests(unittest.TestCase):
+    def test_explicit_collision_selection_excludes_visual_hand_and_floor(self):
+        model = mujoco.MjModel.from_xml_string('''<mujoco><worldbody>
+          <geom name="floor" type="plane" size="1 1 .1"/>
+          <body><geom name="proxy" type="sphere" size=".2" group="3"/>
+          <geom name="visual_hand" type="sphere" size=".2" group="1" contype="0" conaffinity="0"/>
+          </body></worldbody></mujoco>''')
+        names = [mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_GEOM, int(i))
+                 for i in geom.surface_geom_ids(model, "collision_primitives")]
+        self.assertEqual(names, ["proxy"])
+
+    def test_primitive_normals_are_outward_and_faces_nondegenerate(self):
+        for vertices, faces in (geom.sphere_mesh(.2), geom.capsule_mesh(.2, .4),
+                                geom.cylinder_mesh(.2, .4), geom.box_mesh([.2, .3, .4]),
+                                geom.sphere_mesh(1., scale=[.2, .3, .4])):
+            tri = vertices[faces].astype(float)
+            normal = np.cross(tri[:, 1] - tri[:, 0], tri[:, 2] - tri[:, 0])
+            self.assertTrue(np.all(np.linalg.norm(normal, axis=1) > 1e-12))
+            self.assertTrue(np.all(np.sum(normal * tri.mean(axis=1), axis=1) > 0))
+
+    def test_large_triangle_identity_binding(self):
+        vertices = [[-10, -10, 0], [10, -10, 0], [0, 10, 0]]
+        faces = [[0, 1, 2]]
+        for i in range(10):
+            a = 2 * np.pi * i / 10
+            x, y = .2 * np.cos(a), .2 * np.sin(a)
+            k = len(vertices)
+            vertices.extend([[x, y, .1], [x + .01, y, .1], [x, y + .01, .1]])
+            faces.append([k, k + 1, k + 2])
+        bound = common.bind_points_to_mesh([[0., 0., 0.]], vertices, faces, method="exact")
+        self.assertLess(float(bound["errors"].max()), 1e-7)
+        self.assertEqual(int(bound["face_ids"][0]), 0)
+
+    def test_small_triangle_projection_has_no_absolute_region_tolerance(self):
+        vertices = [[0, 0, 0], [.001, 0, 0], [0, .001, 0]]
+        point = [[.00002, .00002, 0.]]
+        binding = common.bind_points_to_mesh(point, vertices, [[0, 1, 2]], method="exact")
+        np.testing.assert_allclose(binding["closest_points"], point, atol=1e-11, rtol=0)
+
+    def test_exact_binding_matches_exhaustive_reference(self):
+        import trimesh
+        rng = np.random.default_rng(17)
+        vertices = rng.normal(size=(90, 3))
+        faces = np.arange(90).reshape(-1, 3)
+        points = rng.normal(size=(20, 3))
+        bound = common.bind_points_to_mesh(points, vertices, faces, method="exact")
+        for i, point in enumerate(points):
+            closest = trimesh.triangles.closest_point(vertices[faces], np.tile(point, (len(faces), 1)))
+            distances = np.linalg.norm(closest - point, axis=1)
+            self.assertAlmostEqual(float(bound["errors"][i]), distances.min(), delta=1e-6)
+            reconstructed = bound["bary"][i] @ vertices[faces[bound["face_ids"][i]]]
+            np.testing.assert_allclose(reconstructed, bound["closest_points"][i], atol=1e-6)
+
+    def test_union_rejects_buried_point_and_binders_fail_closed(self):
+        model = mujoco.MjModel.from_xml_string('''<mujoco><worldbody><body name="pelvis">
+          <geom type="sphere" name="a" size=".2" group="3"/>
+          <geom type="sphere" name="b" pos=".25 0 0" size=".2" group="3"/>
+          </body></worldbody></mujoco>''')
+        data = mujoco.MjData(model)
+        mujoco.mj_forward(model, data)
+        ids = geom.surface_geom_ids(model, "collision_primitives")
+        union = PrimitiveUnion.from_model(model, data, ids, np.zeros(3), np.eye(3))
+        self.assertEqual(union.exterior_mask([[.2, 0, 0], [-.2, 0, 0]], [0, 0]).tolist(), [False, True])
+        config = {"robot": {"name": "synthetic", "xml": "unused.xml", "point_cloud_center": "body:pelvis",
+                            "visual_geom_policy": "collision_primitives", "tpose_qpos": {}}}
+        for binder in (single.bind_robot_slots, batch.bind_robot_slots):
+            with self.assertRaisesRegex(ValueError, "interior slots"):
+                binder(model, SimpleNamespace(config_data=config), [[0, 0, .2]])
+
+    def test_empty_selection_and_invalid_exact_mesh_fail(self):
+        model = mujoco.MjModel.from_xml_string('<mujoco><worldbody><geom type="sphere" size=".2"/></worldbody></mujoco>')
+        with self.assertRaisesRegex(ValueError, "group-3"):
+            geom.surface_geom_ids(model, "collision_primitives")
+        with self.assertRaises(ValueError):
+            common.bind_points_to_mesh([[0, 0, 0]], [[0, 0, 0]], [[0, 0, 0]], method="exact")
+        with self.assertRaises(ValueError):
+            common.bind_points_to_mesh([[np.nan, 0, 0]], np.eye(3), [[0, 1, 2]], method="exact")
+
+
+if __name__ == "__main__":
+    unittest.main()
