--- /dev/null
+++ b/scripts/primitive_surface.py
@@ -0,0 +1,144 @@
+"""Pointwise primitive-union exposure and exact triangle binding.
+
+All points are (N, 3), metres. Geometry IDs retain compiled MuJoCo ordering.
+Exposure excludes the generating geom: triangulated curved faces are inscribed
+in their own analytic primitive. Other primitive interiors are rejected with a
+10 micrometre margin. This is a reference-pose filter, not a Boolean mesher.
+"""
+from dataclasses import dataclass
+
+import mujoco
+import numpy as np
+from scipy.spatial import cKDTree
+
+
+@dataclass(frozen=True)
+class PrimitiveUnion:
+    geom_ids: np.ndarray
+    types: np.ndarray
+    sizes: np.ndarray
+    positions: np.ndarray
+    rotations: np.ndarray
+    tolerance: float = 1e-5
+
+    @classmethod
+    def from_model(cls, model, data, geom_ids, center_pos, center_rot):
+        ids = np.asarray(geom_ids, dtype=np.int32)
+        return cls(ids, model.geom_type[ids].copy(), model.geom_size[ids].copy(),
+                   (data.geom_xpos[ids] - center_pos) @ center_rot,
+                   np.asarray([center_rot.T @ data.geom_xmat[i].reshape(3, 3) for i in ids]))
+
+    def exterior_mask(self, points, owner_geom_ids):
+        """Keep samples not strictly inside another selected analytic primitive."""
+        points = np.asarray(points, dtype=np.float64)
+        owners = np.asarray(owner_geom_ids, dtype=np.int32)
+        if points.ndim != 2 or points.shape[1] != 3 or owners.shape != (len(points),):
+            raise ValueError("Expected points (N, 3) and owner_geom_ids (N,).")
+        if not np.isfinite(points).all() or not np.isin(owners, self.geom_ids).all():
+            raise ValueError("Nonfinite points or owners outside selected geometry.")
+        keep = np.ones(len(points), dtype=bool)
+        for gid, kind, size, pos, rot in zip(self.geom_ids, self.types, self.sizes,
+                                             self.positions, self.rotations):
+            local = (points - pos) @ rot
+            t = self.tolerance
+            if kind == mujoco.mjtGeom.mjGEOM_SPHERE:
+                inside = np.linalg.norm(local, axis=1) < size[0] - t
+            elif kind == mujoco.mjtGeom.mjGEOM_CAPSULE:
+                delta = local.copy()
+                delta[:, 2] -= np.clip(local[:, 2], -size[1], size[1])
+                inside = np.linalg.norm(delta, axis=1) < size[0] - t
+            elif kind == mujoco.mjtGeom.mjGEOM_CYLINDER:
+                inside = ((np.linalg.norm(local[:, :2], axis=1) < size[0] - t)
+                          & (np.abs(local[:, 2]) < size[1] - t))
+            elif kind == mujoco.mjtGeom.mjGEOM_BOX:
+                inside = np.all(np.abs(local) < size[:3] - t, axis=1)
+            elif kind == mujoco.mjtGeom.mjGEOM_ELLIPSOID:
+                inside = np.linalg.norm(local / size[:3], axis=1) < 1 - t / size[:3].min()
+            else:
+                raise ValueError(f"Unsupported primitive type {kind}.")
+            keep &= ~(inside & (owners != gid))
+        return keep
+
+
+def _closest_on_triangles(triangles, points):
+    """Plane projection inside a triangle, otherwise the nearest bounded edge.
+
+    Region decisions use dimensionless barycentrics, with no absolute fourth-
+    order tolerance that can collapse millimetre triangles to their edges.
+    Callers exclude degenerate triangles.
+    """
+    a, b, c = triangles[:, 0], triangles[:, 1], triangles[:, 2]
+    normal = np.cross(b - a, c - a)
+    norm2 = np.sum(normal * normal, axis=1)
+    projected = points - (np.sum((points - a) * normal, axis=1) / norm2)[:, None] * normal
+    v = np.sum(np.cross(projected - a, c - a) * normal, axis=1) / norm2
+    w = np.sum(np.cross(b - a, projected - a) * normal, axis=1) / norm2
+    interior = (v >= 0) & (w >= 0) & (v + w <= 1)
+    edges = []
+    for start, end in ((a, b), (b, c), (c, a)):
+        delta = end - start
+        factor = np.sum((points - start) * delta, axis=1) / np.sum(delta * delta, axis=1)
+        edges.append(start + np.clip(factor, 0, 1)[:, None] * delta)
+    edges = np.stack(edges, axis=1)
+    distances = np.sum((edges - points[:, None, :]) ** 2, axis=2)
+    closest = edges[np.arange(len(points)), np.argmin(distances, axis=1)]
+    closest[interior] = projected[interior]
+    return closest
+
+
+def bind_points_to_mesh_exact(points, vertices, faces):
+    """Globally nearest nondegenerate triangle, with deterministic face ties.
+
+    A centroid tree supplies candidates. Its radius is the distance to an initial
+    triangle plus the largest centroid-to-vertex radius. The triangle inequality
+    guarantees that a closer triangle cannot be omitted. No nearest-vertex
+    shortcut or dependency on optional spatial-index packages is used.
+    """
+    points = np.asarray(points, dtype=np.float64)
+    vertices = np.asarray(vertices, dtype=np.float64)
+    faces = np.asarray(faces, dtype=np.int32)
+    if points.ndim != 2 or points.shape[1] != 3 or vertices.ndim != 2 or vertices.shape[1] != 3:
+        raise ValueError("Expected points and vertices with shape (N, 3).")
+    if faces.ndim != 2 or faces.shape[1] != 3 or not len(faces):
+        raise ValueError("Expected nonempty triangular faces (F, 3).")
+    if not np.isfinite(points).all() or not np.isfinite(vertices).all():
+        raise ValueError("Mesh and query points must be finite.")
+    if faces.min() < 0 or faces.max() >= len(vertices):
+        raise ValueError("Face index outside vertex array.")
+    tri = vertices[faces]
+    cross = np.cross(tri[:, 1] - tri[:, 0], tri[:, 2] - tri[:, 0])
+    lengths = np.linalg.norm(cross, axis=1)
+    valid_ids = np.flatnonzero(lengths > 1e-12)
+    if not len(valid_ids):
+        raise ValueError("No nondegenerate triangles for binding.")
+    triangles = tri[valid_ids]
+    centers = triangles.mean(axis=1)
+    radii = np.linalg.norm(triangles - centers[:, None, :], axis=2).max(axis=1)
+    tree = cKDTree(centers)
+    _, initial_ids = tree.query(points, k=1)
+    first = _closest_on_triangles(triangles[initial_ids], points)
+    bounds = np.linalg.norm(first - points, axis=1)
+    chosen = np.empty(len(points), dtype=np.int32)
+    closest = np.empty_like(points)
+    for i, point in enumerate(points):
+        candidates = np.asarray(tree.query_ball_point(point, bounds[i] + radii.max() + 1e-12), dtype=int)
+        lower = np.linalg.norm(centers[candidates] - point, axis=1) - radii[candidates]
+        candidates = np.sort(candidates[lower <= bounds[i] + 1e-12])
+        projected = _closest_on_triangles(triangles[candidates], np.broadcast_to(point, (len(candidates), 3)))
+        dist2 = np.sum((projected - point) ** 2, axis=1)
+        best = int(np.argmin(dist2))
+        chosen[i] = valid_ids[candidates[best]]
+        closest[i] = projected[best]
+    selected = tri[chosen]
+    v0, v1, v2 = selected[:, 1] - selected[:, 0], selected[:, 2] - selected[:, 0], closest - selected[:, 0]
+    dot = lambda a, b: np.sum(a * b, axis=1)
+    d00, d01, d11 = dot(v0, v0), dot(v0, v1), dot(v1, v1)
+    d20, d21 = dot(v2, v0), dot(v2, v1)
+    denom = d00 * d11 - d01 * d01
+    v = (d11 * d20 - d01 * d21) / denom
+    w = (d00 * d21 - d01 * d20) / denom
+    bary = np.stack([1 - v - w, v, w], axis=1)
+    return {"face_ids": chosen, "bary": bary.astype(np.float32),
+            "closest_points": closest.astype(np.float32),
+            "closest_normals": (cross[chosen] / lengths[chosen, None]).astype(np.float32),
+            "errors": np.linalg.norm(closest - points, axis=1).astype(np.float32)}
